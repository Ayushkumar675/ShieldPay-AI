# ShieldPay AI - Production Environment Variables Example

# App settings
APP_NAME="ShieldPay AI"
APP_VERSION="1.0.0"
DEBUG=False

# Database
MONGODB_DB_NAME="shieldpay"
# MONGODB_URL is automatically set in docker-compose.prod.yml

# Security
JWT_SECRET_KEY="replace-this-with-a-strong-random-key"
JWT_EXPIRATION_MINUTES=1440

# Third-Party APIs (Weather, Traffic)
WEATHER_API_KEY="your-weather-api-key"
TRAFFIC_API_KEY="your-traffic-api-key"

# CORS Configuration (If accessed directly via backend public IP instead of Nginx reverse proxy)
CORS_ORIGINS="http://yourdomain.com,https://yourdomain.com"
